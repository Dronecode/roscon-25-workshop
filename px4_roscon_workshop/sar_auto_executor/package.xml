<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sar_auto_executor</name>
  <version>0.0.1</version>
  <description>Auto-switching executor for the SAR swarm modes, built on top of sar_modes.</description>

  <maintainer email="totonzx@gmail.com">Alexis Guijarro</maintainer>
  <license>CC-BY-SA-4.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Runtime and build dependencies -->
  <depend>rclcpp</depend>
  <depend>px4_ros2_cpp</depend>
  <depend>eigen3_cmake_module</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <!-- launch file runs sar_modes's fake_rover_mover.py -->
  <exec_depend>sar_modes</exec_depend>
  <exec_depend>px4_roscon_workshop</exec_depend>

  <!-- Optional test tools -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
